//! Prove an ERC-20 token balance at a given block — the full
//! `state root → token account → balances[holder]` chain.
//!
//! Two proofs are needed, because a token balance lives in the token
//! contract's *storage* trie:
//!
//!   1. an account proof placing the token contract (and therefore its storage
//!      root) under the block's state root, and
//!   2. a storage proof placing `balances[holder]` under that storage root.
//!
//! Inputs are generated by `scripts/generate_example_inputs.py` against real
//! mainnet USDC. Run with:
//!     nargo execute

use evm_storage_proofs::slot_key::address_mapping_slot;
use evm_storage_proofs::types::{Account, Node, StorageSlot};
use evm_storage_proofs::{verify_account_proof, verify_storage_proof};

global MAX_ACCOUNT_PATH: u32 = 10;
/// Storage-trie depth depends on how many slots the contract uses. USDC has
/// millions of holders, so its balance paths run deep.
global MAX_STORAGE_PATH: u32 = 9;

/// Declaration slot of USDC's `balances` mapping (FiatTokenV2_2 layout).
/// Changing token means changing this — it is a property of the contract's
/// storage layout, not of the proof.
global BALANCES_SLOT: u32 = 9;

fn main(
    // Trusted block state root.
    state_root: pub [u64; 4],
    // The token contract and the holder whose balance is being proven.
    token: pub [u8; 20],
    holder: pub [u8; 20],
    // Witness: the token account leaf + its proof path.
    account: Account,
    account_nodes: [Node; MAX_ACCOUNT_PATH],
    account_node_length: u32,
    // Witness: the balance slot contents + its proof path.
    balance_slot: StorageSlot,
    storage_nodes: [Node; MAX_STORAGE_PATH],
    storage_node_length: u32,
) -> pub u128 {
    // 1. The account really is the token contract, and it really is in the
    //    state trie under the trusted root. This is what makes
    //    `account.storage_hash` trustworthy.
    assert_eq(account.address, token, "proof is for a different account");
    verify_account_proof(state_root, account, account_nodes, account_node_length);

    // 2. Derive the slot location in-circuit from the holder address. This is
    //    the step that ties the proven value to `balances[holder]`; taking
    //    slot_key as an input instead would let the prover point at any slot
    //    (another holder's balance, or `totalSupply`).
    let slot_key = address_mapping_slot(holder, BALANCES_SLOT);
    verify_storage_proof(
        account.storage_hash,
        slot_key,
        balance_slot,
        storage_nodes,
        storage_node_length,
    );

    // Token balances fit 128 bits comfortably; to_u128 asserts that the proven
    // value actually does.
    balance_slot.to_u128()
}
